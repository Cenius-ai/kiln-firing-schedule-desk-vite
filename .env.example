# Kiln Firing Schedule Desk — example environment.
#
# The app boots with NO .env at all: every value below has a working default in
# code, and the JWT signing secret is generated per install (backend/.jwt_secret)
# the first time the backend starts. Copy this file to `.env` only to override.

# Port the FastAPI service binds to (the Vite proxy targets 8000).
PORT=8000

# SQLite file; relative to the backend directory when the backend is started there.
KILN_DATABASE_URL=sqlite:///./kiln.db

# Leave empty to auto-generate a random per-install secret.
KILN_JWT_SECRET=

# Set to true only when serving over HTTPS (a Secure cookie is dropped on plain http).
KILN_COOKIE_SECURE=false

# Browser origins allowed to call the API directly (the dev proxy is same-origin).
KILN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public origin of the studio app, used by the backend's fallback landing page.
# Override it when the app is served from a real hostname (split deploy / production).
KILN_FRONTEND_URL=http://localhost:5173
